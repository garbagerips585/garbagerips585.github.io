# Copy this file to .env and paste your own key in.
# .env is gitignored, so it never gets committed or deployed.
#
#   cp .env.example .env
#   node --env-file=.env scripts/sync-youtube.mjs
#
# Get a key at https://console.cloud.google.com/
#   New project -> APIs & Services -> Library -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key
#
# Then restrict it: Edit the key -> API restrictions -> Restrict key ->
# YouTube Data API v3. A restricted key is useless for anything else.

YT_API_KEY=paste_your_key_here

# pokemonpricetracker.com: PSA 10 and raw near-mint prices for chase cards.
# Free tier is 100 credits a day (about 50 cards); $9.99/mo lifts it to 20,000.
# Used by scripts/sync-prices.mjs. Never commit the real value.
PPT_API_KEY=
